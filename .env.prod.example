# ---------------------------------------------------------------------------
# FlowForge production environment template (docker-compose.prod.yml).
# Copy to `.env` on the deploy host (gitignored) and adjust. NEVER commit
# real secrets. Everything here has an inert default so `config -q` works
# without this file — but a real deployment must set the secrets.
# ---------------------------------------------------------------------------

# Secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE-ME-production-secret-at-least-32-chars

# Public origin of the deployment (drives CORS + refresh cookies)
APP_URL=https://flowforge.example.com
CORS_ORIGINS=https://flowforge.example.com

# Replica counts (read by the deploy workflow / your `up` command)
# API_REPLICAS=3
# WORKER_REPLICAS=1

# Container images — the deploy workflow pins these to the pushed SHA tags
# API_IMAGE=ghcr.io/OWNER/REPO-api:latest
# WEB_IMAGE=ghcr.io/OWNER/REPO-web:latest

# Object storage (defaults point at the bundled SeaweedFS container).
# To use AWS S3 / Cloudflare R2 instead, point S3_ENDPOINT at the provider and
# set the real credentials. Rotate the bundled SeaweedFS identity in
# infra/seaweedfs/s3.json for any real deployment.
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=flowforge-attachments
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Observability profile password
# GRAFANA_PASSWORD=

# Per-client API budget per minute (default 600). Raise for load tests or
# trusted internal clients; the budget is shared across replicas via Redis.
# API_RATE_LIMIT_PER_MIN=600

# ---------------------------------------------------------------------------
# TLS / ACME (optional — Traefik terminates TLS when enabled)
#
# 1. Uncomment the 443 port mapping in docker-compose.prod.yml (traefik.ports).
# 2. Add these flags to the traefik service command:
#      - --certificatesresolvers.le.acme.email=ops@example.com
#      - --certificatesresolvers.le.acme.storage=/acme/acme.json
#      - --certificatesresolvers.le.acme.tlschallenge=true
# 3. Add an `acme` named volume mounted at /acme (Traefik creates acme.json
#    with restrictive permissions itself).
# 4. Switch both routers from `web` to `websecure` and add
#      - traefik.http.routers.ff-api.tls.certresolver=le
#      - traefik.http.routers.ff-web.tls.certresolver=le
# Without TLS termination at Traefik, put it behind your existing
# HTTPS load balancer / reverse proxy instead (COOKIE_SECURE=true expects
# the edge to speak HTTPS).
# ---------------------------------------------------------------------------
