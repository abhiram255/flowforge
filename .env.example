# ---------------------------------------------------------------------------
# FlowForge environment template.
# Copy to `.env` (gitignored) and adjust. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Process role: `all` (API + workers, development default) | `api` | `worker`.
# Production runs `api` replicas plus a separate `worker` tier (see docker-compose.prod.yml).
PROCESS_ROLE=all

# How many reverse-proxy hops sit in front of the API (Traefik/nginx = 1; direct exposure = 0)
TRUST_PROXY_HOPS=1

# HTTP server timeouts (ms). keepAliveTimeout should sit above intermediary idle
# timeouts; headersTimeout must exceed keepAliveTimeout. requestTimeout bounds how
# long a client may take to *send* a request (websockets/streams are unaffected).
HTTP_KEEPALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=66000
HTTP_REQUEST_TIMEOUT_MS=30000
# How long graceful shutdown waits for in-flight requests (docker stop_grace_period must exceed it)
DRAIN_TIMEOUT_MS=10000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/flowforge_dev
# Connection pool per process — keep maxPoolSize × replicas under the server's connection budget
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=0
MONGODB_SOCKET_TIMEOUT_MS=45000
# Analytics/dashboard aggregations only; auth and task reads always use the primary
MONGODB_ANALYTICS_READ_PREFERENCE=primary
# true in dev/test; production sets false and runs the one-shot `ensure-indexes` script
MONGODB_AUTO_INDEX=true

# Auth — generate production secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# Redis (optional in development — cache and queues degrade gracefully without it;
# REQUIRED in production, and for PROCESS_ROLE=worker)
REDIS_URL=redis://127.0.0.1:6379

# Logging
LOG_LEVEL=debug

# Limits and caching
API_RATE_LIMIT_PER_MIN=600
CACHE_MEMORY_MAX_ENTRIES=5000

# File storage: `local` (default, disk-backed) or `s3` (any S3-compatible service: AWS, MinIO, R2 —
# required for multi-replica deployments since replicas do not share local disks)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# Temp dir for streamed uploads; files are removed right after the transfer
UPLOAD_TMP_DIR=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=flowforge
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Email (optional — without SMTP_URL, mail is logged to the console in dev)
SMTP_URL=
MAIL_FROM=FlowForge <no-reply@flowforge.local>

# Uploads
MAX_UPLOAD_MB=10

# Dev/E2E only — refused when NODE_ENV=production
SEED_ON_START=false
SEED_RESET=false
# Explicit opt-in to seed a NODE_ENV=production stack (demo/staging only)
SEED_FORCE=false
