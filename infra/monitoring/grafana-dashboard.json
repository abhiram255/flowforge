{
  "title": "FlowForge API",
  "uid": "flowforge-api",
  "schemaVersion": 39,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Request p95 latency by route",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route, method) (rate(flowforge_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (status) (rate(flowforge_http_requests_total[5m]))",
          "legendFormat": "status {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error ratio (5xx)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "sum(rate(flowforge_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(flowforge_http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active websocket connections",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "targets": [{ "expr": "flowforge_ws_connections", "legendFormat": "connections" }]
    },
    {
      "type": "timeseries",
      "title": "Process memory (RSS)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "targets": [
        {
          "expr": "flowforge_process_resident_memory_bytes",
          "legendFormat": "rss"
        }
      ]
    }
  ]
}
